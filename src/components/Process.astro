---
import { Image } from 'astro:assets';
import { img } from '../lib/img.js';
import SectionHead from './SectionHead.astro';
const { showHead = true } = Astro.props;
const STEPS = [
  { k: 'Step 1', t: 'Valutazione del progetto', p: 'Una call conoscitiva per capire obiettivi, pubblico e tempi. Analizziamo la fattibilità e ti mandiamo una proposta chiara.' },
  { k: 'Step 2', t: 'Inizio dei lavori e comunicazione costante', p: 'Partiamo dalla strategia, poi design e produzione. Revisioni a tappe e un referente diretto.' },
  { k: 'Step 3', t: 'Consegna del progetto', p: 'Ti consegniamo tutti i file e le linee guida per usarli. Se serve, ti seguiamo anche dopo il lancio.' },
];
---
{showHead && <SectionHead chip="Come funziona" title="Scopri qual è il <em>processo</em> per <em>lanciare</em> il tuo progetto!" lead="Lavoriamo passo dopo passo al tuo fianco per garantire la massima qualità e attenzione al dettaglio." />}
<div class="process">
  <div class="pimg rv"><Image src={img('process.jpg')} alt="Un designer al lavoro al computer" widths={[480, 720, 960, 1200]} sizes="(max-width: 900px) calc(100vw - 48px), 552px" loading="lazy" /></div>
  <ol class="steps rv">
    {STEPS.map((s) => <li class="step"><span class="k">{s.k}</span><h3>{s.t}</h3><p>{s.p}</p></li>)}
  </ol>
</div>
