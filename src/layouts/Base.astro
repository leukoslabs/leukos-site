---
/* Layout di tutte le pagine: <head> con SEO e dati strutturati, nav, footer, script delle animazioni. */
import '@fontsource-variable/space-grotesk';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, NAV } from '../data/site.js';
import { img } from '../lib/img.js';

interface Props {
  title: string;
  description: string;
  current?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, current, image = img('og.jpg'), imageAlt = 'Leukos, studio creativo a Benevento', type = 'website', jsonLd = [], noindex = false } = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site).href;
const orgId = new URL('/#leukos', site).href;

const graph = [
  {
    '@type': 'ProfessionalService',
    '@id': orgId,
    name: SITE.name,
    slogan: SITE.tagline,
    description: SITE.description,
    url: new URL('/', site).href,
    logo: new URL('/brand/logo-512.png', site).href,
    image: ogUrl,
    email: SITE.email,
    telephone: SITE.phoneE164,
    vatID: 'IT' + SITE.vat,
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
    areaServed: [{ '@type': 'City', name: 'Benevento' }, { '@type': 'Country', name: 'Italia' }],
    founder: [{ '@id': new URL('/chi-siamo/#antonio-pennino', site).href }, { '@id': new URL('/chi-siamo/#mariano-iscaro', site).href }],
    knowsAbout: ['Brand identity', 'UI/UX design', 'Web design', 'Social media', 'Video editing', 'Motion design', 'Riprese e regia'],
  },
  { '@type': 'WebSite', '@id': new URL('/#website', site).href, url: new URL('/', site).href, name: SITE.name, inLanguage: 'it-IT', publisher: { '@id': orgId } },
  ...jsonLd,
];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#e46e2a">
  <link rel="icon" href="/brand/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:type" content={type}>
  <meta property="og:site_name" content="Leukos">
  <meta property="og:locale" content="it_IT">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">

  <!-- le animazioni d'ingresso valgono solo se JavaScript è attivo: senza JS si vede tutto subito -->
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  <slot name="head" />
</head>
<body>
<a class="skip" href="#main">Vai al contenuto</a>

<header class="nav" id="nav">
  <a class="brand" href="/" aria-label="Leukos, home"><img class="star" src="/brand/star-sm.svg" alt="" width="30" height="30"><span class="wm" aria-hidden="true"><b>L</b><i>e</i><b>u</b><i>k</i><b>o</b><i>s</i></span></a>
  <nav aria-label="Principale">
    <ul id="navList">
      {NAV.map((n) => <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <a class="btn btn-ghost" href="/contatti/">Inizia ora</a>
  <button class="menu-btn" id="menuBtn" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="navList"><span></span><span></span><span></span></button>
</header>

<main id="main">
  <slot />
</main>

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <img src="/brand/star.svg" alt="" width="56" height="56" style="margin-bottom:12px">
        <p class="tag">La tua <em>essenza</em> in ogni formato.</p>
      </div>
      <nav aria-label="Footer">
        {NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href="/contatti/">Contatti</a>
      </nav>
    </div>
    <div class="copy">
      <span>© {new Date().getFullYear()} Leukos · {SITE.city}, Italia · <span class="nowrap">{SITE.vatHolder}</span> · <span class="nowrap">P.IVA {SITE.vat}</span> · <span class="legal-links"><a href="/privacy/">Privacy</a> · <a href="/cookie/">Cookie</a></span></span>
      <span><a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
    </div>
    <div class="giant wm" aria-hidden="true"><b>L</b><i>e</i><b>u</b><i>k</i><b>o</b><i>s</i></div>
  </div>
</footer>

<script>
  import '../scripts/motion.js';
</script>
</body>
</html>
